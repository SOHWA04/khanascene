{
  "expo": {
    "name": "KhanaScene",
    "slug": "khanascene",
    "version": "1.0.0",
    "description": "Pakistan's restaurant discovery guide. Find verified menus, bank card discounts, parking reality, and calculate your bill before ordering in Islamabad & Rawalpindi.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "khanascene",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "pk.khanascene.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KhanaScene uses your location when you choose 'Near Me' to show nearby restaurants in Islamabad and Rawalpindi."
      }
    },
    "android": {
      "package": "pk.khanascene.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#173D32",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173D32",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KhanaScene uses your location when you choose 'Near Me' to show nearby restaurants in Islamabad and Rawalpindi."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
