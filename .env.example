# KhanaScene Public Client Environment Configuration
# Copy this file to .env.local for local development.
# DO NOT place privileged secrets (GOOGLE_PLACES_API_KEY, SUPABASE_SERVICE_ROLE_KEY) in EXPO_PUBLIC_ variables!

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
EXPO_PUBLIC_DATA_MODE=mock
EXPO_PUBLIC_DEFAULT_CITY=islamabad
